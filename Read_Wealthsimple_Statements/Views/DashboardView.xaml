<UserControl x:Class="Read_Wealthsimple_Statements.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Read_Wealthsimple_Statements.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid DataContext="{Binding CurrentViewModel}">
        <!--Divides main window into two columns-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!--Button to change the users current Directory of statements-->
            <Button Content="Change Directory" x:Name="btnChangeDirectory" Command="{Binding ChangeDirectoryCommand}" Grid.Row="0"/>
            <!--WHere the available statements are listed-->
            <ListBox x:Name="lstBoxStatements" ItemsSource="{Binding Statements}" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding title}"  Padding="4,0,0,4" Background="Transparent"  Tag="{Binding filePath}" x:Name="btnChangeDocument" Command="{Binding SelectStatementCommand}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>


        <!--Main Area where information will be displayed-->
        <Grid Grid.Column="0">
            <!--Divides first Column into two rows-->
            <Grid.RowDefinitions>
                <!--Main Area-->
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--Main area to put information-->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <!---List of transactions in excel document-->
                <!--List all transactions of a particular statement-->
                <ListView Grid.Row="0" MaxHeight="300" x:Name="lvTransactions" VerticalAlignment="Top" ItemsSource="{Binding Transactions}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding date, StringFormat={}{0:d}}" />
                            <GridViewColumn Header="Description" DisplayMemberBinding="{Binding description}" />
                            <GridViewColumn Header="Transaction" DisplayMemberBinding="{Binding transactionType}" />
                            <GridViewColumn Header="Amount" DisplayMemberBinding="{Binding amount,StringFormat=C }"  />
                            <GridViewColumn Header="Balance" DisplayMemberBinding="{Binding  balance, StringFormat=C}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <!---Financial overview-->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions >
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Financial Overview" FontSize="16" FontWeight="Bold" Grid.Row="0"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Stretch" >
                        <Label Content="Total Spent:" x:Name="lblTotalSpent" Width="auto"/>
                        <Label Content="{Binding test}" x:Name="lblTotalSpentValue" Height="auto"/>
                        <Label Content="Dividends Earned:" x:Name="lblDividendsEarned" Width="auto" />
                        <Label Content="" x:Name="lblDividendsEarnedValue" />
                        <Label Content="Ending Balance of the Month:" x:Name="lblEndingBalance" Width="auto" />
                        <Label Content="" x:Name="lblEndingBalanceValue" />
                    </StackPanel>
                </Grid>
                

                <!---Stock overview-->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions >
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Stock Overview" FontSize="16" FontWeight="Bold" Grid.Row="0"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Stretch" >

                    </StackPanel>
                </Grid>
                
            </Grid>
            
            

        </Grid>
    </Grid>
</UserControl>
